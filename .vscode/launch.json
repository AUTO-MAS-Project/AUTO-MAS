{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Dev: Backend",
      "type": "node-terminal",
      "request": "launch",
      "command": ".venv\\Scripts\\python.exe main.py",
      "cwd": "${workspaceFolder}",
      "env": {
        "AUTO_MAS_DEV": "1",
        "PYTHONUNBUFFERED": "1"
      },
      "presentation": {
        "group": "dev",
        "order": 1
      }
    },
    {
      "name": "Dev: Frontend",
      "type": "node-terminal",
      "request": "launch",
      "command": "cmd /c \"yarn wait-on tcp:36163 --timeout 120000 && yarn dev\"",
      "cwd": "${workspaceFolder}/frontend",
      "env": {
        "COREPACK_ENABLE_DOWNLOAD_PROMPT": "0"
      },
      "presentation": {
        "group": "dev",
        "order": 2
      }
    }
  ],
  "compounds": [
    {
      "name": "Dev: Backend + Frontend",
      "configurations": ["Dev: Backend", "Dev: Frontend"],
      "stopAll": true,
      "presentation": {
        "group": "dev",
        "order": 1
      }
    }
  ]
}
