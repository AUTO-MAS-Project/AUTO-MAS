{
  "name": "frontend",
  "private": true,
  "version": "v5.8.0-beta.1",
  "description": "A Multi-Script, Multi-Config Management and Automation Software",
  "author": "AUTO-MAS Team",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently \"vp dev\" \"yarn watch:main\" \"yarn electron-dev\"",
    "dev:fullstack": "concurrently \"yarn backend\" \"vp dev\" \"yarn watch:main\" \"yarn electron-dev:wait\"",
    "backend": "cross-env PYTHONIOENCODING=utf-8 AUTO_MAS_HTTP_PORT=36164 python ../main.py",
    "electron-dev:wait": "wait-on http://127.0.0.1:5173 http://127.0.0.1:36164/openapi.json && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "watch:main": "tsc -p tsconfig.electron.json --watch",
    "electron-dev": "wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "build:main": "tsc -p tsconfig.electron.json",
    "build": "vp build && yarn build:main && electron-builder --publish never",
    "web": "vp dev",
    "release": "vp build && yarn build:main && electron-builder --win --publish always",
    "release:full": "vp build && yarn build:main && electron-builder --win --publish always --config build-json/electron-builder-full.json",
    "release:lite": "vp build && yarn build:main && electron-builder --win --publish always --config build-json/electron-builder-lite.json",
    "lint": "vp lint .",
    "lint:fix": "vp lint . --fix",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "lint:md:fix": "markdownlint-cli2 --fix \"**/*.md\"",
    "format": "vp fmt . --write",
    "format:check": "vp fmt . --check",
    "typecheck": "vue-tsc -p tsconfig.app.json --noEmit",
    "openapi": "openapi --input http://127.0.0.1:36164/openapi.json --output ./src/api --client axios && node scripts/postprocess-openapi.mjs",
    "test": "vp test run",
    "e2e": "node e2e/run.mjs",
    "e2e:init": "node e2e/run.mjs --grep @init",
    "e2e:smoke": "node e2e/run.mjs --grep @smoke",
    "e2e:queue": "node e2e/run.mjs --grep @queue",
    "e2e:scheduler": "node e2e/run.mjs --grep @scheduler",
    "e2e:settings": "node e2e/run.mjs --grep @settings",
    "e2e:history": "node e2e/run.mjs --grep @history",
    "e2e:recovery": "node e2e/run.mjs --grep @recovery",
    "e2e:notify": "node e2e/run.mjs --grep @notify",
    "e2e:real": "pwsh -NoProfile -File ./e2e/run-real.ps1",
    "e2e:real:local": "pwsh -NoProfile -File ./e2e/run-real.ps1",
    "e2e:real:all": "node e2e/real-batch.mjs",
    "e2e:ui": "node e2e/run.mjs --ui",
    "e2e:report": "node e2e/report.mjs",
    "e2e:check": "node --test e2e/harness.check.mjs && tsc -p tsconfig.e2e.json",
    "audit:baseline": "node scripts/audit-baseline.mjs",
    "audit:unused": "knip --no-progress",
    "audit:duplicates": "jscpd src electron"
  },
  "build": {
    "asar": true,
    "asarUnpack": [],
    "extraMetadata": {
      "env": "prod"
    },
    "appId": "top.auto-mas.frontend",
    "productName": "AUTO-MAS",
    "files": [
      "dist/index.html",
      "dist/mascot.html",
      "dist/mascot-menu.html",
      "dist/assets/**",
      "!dist/assets/**/*.map",
      "dict/AUTO-MAS.ico",
      "dict/logo.png",
      "dict/prts.png",
      "dist-electron/**",
      "public/**",
      "!src/**",
      "!**/*.map"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "AUTO-MAS-Project",
        "repo": "AUTO-MAS"
      }
    ],
    "extraResources": [
      {
        "from": "src/assets",
        "to": "assets",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "requestedExecutionLevel": "requireAdministrator",
      "icon": "public/AUTO-MAS.ico"
    }
  },
  "dependencies": {
    "@sentry/electron": "7.16.0",
    "@sentry/vue": "10.67.0",
    "adm-zip": "^0.5.16",
    "axios": "1.15.2",
    "electron-log": "^5.4.3",
    "form-data": "^4.0.4",
    "yaml": "2.8.1"
  },
  "devDependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "@guolao/vue-monaco-editor": "^1.6.0",
    "@playwright/test": "1.64.0",
    "@sentry/vite-plugin": "^5.4.0",
    "@tanstack/vue-query": "^5.104.4",
    "@types/adm-zip": "^0.5.8",
    "@types/markdown-it": "^14.1.2",
    "@types/matter-js": "^0",
    "@types/node": "22.17.1",
    "@types/qrcode": "1.5.5",
    "@types/three": "^0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/tsconfig": "^0.7.0",
    "@vueuse/core": "^13.9.0",
    "ant-design-vue": "4.x",
    "concurrently": "^9.2.0",
    "cross-env": "^10.0.0",
    "dayjs": "^1.11.13",
    "electron": "^43.8.2",
    "electron-builder": "26.8.1",
    "electron-builder-squirrel-windows": "26.15.3",
    "jscpd": "5.4.1",
    "knip": "6.41.0",
    "markdown-it": "^14.1.1",
    "markdownlint-cli2": "^0.18.1",
    "matter-js": "^0.20.0",
    "monaco-editor": "0.54.0",
    "openapi-typescript-codegen": "^0.29.0",
    "pinia": "^3.0.3",
    "qrcode": "1.5.4",
    "three": "^0.184.0",
    "typescript": "^5.9.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vue": "^3.5.17",
    "vue-i18n": "^11.4.10",
    "vue-router": "4",
    "vue-tsc": "^3.2.0",
    "vuedraggable": "^4.1.0",
    "wait-on": "^8.0.4"
  },
  "resolutions": {
    "@types/node": "22.17.1",
    "ajv@^6.10.0": "6.14.0",
    "ajv@^6.12.0": "6.14.0",
    "ajv@^6.12.4": "6.14.0",
    "flatted": "^3.4.2",
    "dompurify@3.1.7": "3.2.7",
    "lodash-es@^4.17.15": "4.17.23",
    "minimatch@^3.0.4": "3.1.3",
    "minimatch@^3.0.5": "3.1.3",
    "minimatch@^3.1.1": "3.1.3",
    "minimatch@^3.1.2": "3.1.3",
    "minimatch@^5.0.1": "5.1.7",
    "minimatch@^9.0.3": "9.0.6",
    "minimatch@^9.0.4": "9.0.6",
    "minimatch@^10.0.3": "10.2.1",
    "minimatch@^10.1.1": "10.2.1",
    "picomatch@^2.3.1": "2.3.2",
    "picomatch@^4.0.3": "4.0.4",
    "rollup": "4.59.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0"
  },
  "packageManager": "yarn@4.18.1"
}
