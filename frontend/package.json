{
  "name": "frontend",
  "private": true,
  "version": "v6.0.0-alpha.NEXUS-OVERDRIVE.20260726.11",
  "description": "A Multi-Script, Multi-Config Management and Automation Software",
  "author": "AUTO-MAS Team",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently \"vite\" \"yarn watch:main\" \"yarn electron-dev\"",
    "dev:fullstack": "concurrently \"yarn backend\" \"vite\" \"yarn watch:main\" \"yarn electron-dev:wait\"",
    "backend": "python ../main.py",
    "electron-dev:wait": "wait-on http://localhost:5173 http://localhost:36163 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 node scripts/electron-spawn.mjs .",
    "watch:main": "tsc -p tsconfig.electron.json --watch",
    "electron-dev": "wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 node scripts/electron-spawn.mjs .",
    "build:main": "tsc -p tsconfig.electron.json",
    "build": "vite build && yarn verify:renderer-chunks && yarn build:main && yarn validate:wheelhouse && electron-builder --publish never",
    "web": "vite",
    "release": "vite build && yarn verify:renderer-chunks && yarn build:main && yarn validate:wheelhouse && electron-builder --win --x64 --publish never",
    "release:integration": "node scripts/build-integration-release.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "typecheck": "vue-tsc -p tsconfig.app.json --noEmit",
    "openapi": "openapi --input http://127.0.0.1:36163/openapi.json --output ./src/api --client axios",
    "test": "vitest run",
    "validate:wheelhouse": "node scripts/validate-wheelhouse.mjs",
    "verify:renderer-chunks": "node scripts/verify-renderer-chunks.mjs",
    "validate:wheelhouse:integration": "node scripts/validate-wheelhouse.mjs --wheelhouse ../plugins/wheels --require-snapshot-contract"
  },
  "build": {
    "asar": true,
    "asarUnpack": [],
    "extraMetadata": {
      "env": "prod"
    },
    "appId": "top.auto-mas.frontend",
    "productName": "AUTO-MAS",
    "toolsets": {
      "winCodeSign": "1.1.0"
    },
    "files": [
      "dist/index.html",
      "dist/assets/**",
      "dist-electron/**",
      "public/**",
      "!src/**",
      "!**/*.map"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "AUTO-MAS-Project",
        "repo": "AUTO-MAS"
      }
    ],
    "extraResources": [
      {
        "from": "src/assets",
        "to": "assets",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../res/integration-snapshot.json",
        "to": "integration-snapshot/manifest.json"
      },
      {
        "from": "../app",
        "to": "integration-snapshot/app",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.py[oc]"
        ]
      },
      {
        "from": "../res",
        "to": "integration-snapshot/res",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../scripts",
        "to": "integration-snapshot/scripts",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.py[oc]"
        ]
      },
      {
        "from": "../plugins/auto_mas_core",
        "to": "integration-snapshot/plugins/auto_mas_core",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.py[oc]",
          "!build/**",
          "!dist/**",
          "!**/*.egg-info/**"
        ]
      },
      {
        "from": "../plugins/browser",
        "to": "integration-snapshot/plugins/browser",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.py[oc]",
          "!build/**",
          "!dist/**",
          "!**/*.egg-info/**",
          "!tests/**"
        ]
      },
      {
        "from": "../plugins/ok_script_adapter",
        "to": "integration-snapshot/plugins/ok_script_adapter",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.py[oc]",
          "!build/**",
          "!dist/**",
          "!**/*.egg-info/**"
        ]
      },
      {
        "from": "../plugins/okww_adapter",
        "to": "integration-snapshot/plugins/okww_adapter",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.py[oc]",
          "!build/**",
          "!dist/**",
          "!**/*.egg-info/**"
        ]
      },
      {
        "from": "../plugins/wheels",
        "to": "integration-snapshot/plugins/wheels",
        "filter": [
          "*.whl",
          "manifest.json",
          "runtime-lock.json",
          "pylock.host.toml",
          "pylock.combined.toml"
        ]
      },
      {
        "from": "../main.py",
        "to": "integration-snapshot/main.py"
      },
      {
        "from": "../pyproject.toml",
        "to": "integration-snapshot/pyproject.toml"
      },
      {
        "from": "../requirements.txt",
        "to": "integration-snapshot/requirements.txt"
      },
      {
        "from": "../LICENSE",
        "to": "integration-snapshot/LICENSE"
      },
      {
        "from": "../README.md",
        "to": "integration-snapshot/README.md"
      }
    ],
    "win": {
      "requestedExecutionLevel": "asInvoker",
      "icon": "public/AUTO-MAS.ico"
    }
  },
  "dependencies": {
    "@inspira-ui/plugins": "^0.0.2",
    "adm-zip": "^0.5.16",
    "axios": "1.15.2",
    "electron-log": "^5.4.3",
    "form-data": "^4.0.4",
    "motion-v": "^2.3.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "@eslint/js": "^9.37.0",
    "@guolao/vue-monaco-editor": "^1.6.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/adm-zip": "^0.5.8",
    "@types/matter-js": "^0",
    "@types/node": "22.17.1",
    "@types/three": "^0",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/tsconfig": "^0.7.0",
    "@vueuse/core": "^13.9.0",
    "ant-design-vue": "4.x",
    "concurrently": "^9.2.0",
    "cross-env": "^10.0.0",
    "dayjs": "^1.11.13",
    "electron": "^37.2.5",
    "electron-builder": "26.8.1",
    "electron-builder-squirrel-windows": "26.15.3",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.3",
    "eslint-plugin-vue": "^10.4.0",
    "globals": "^16.4.0",
    "markdown-it": "^14.1.1",
    "matter-js": "^0.20.0",
    "monaco-editor": "0.54.0",
    "openapi-typescript-codegen": "^0.29.0",
    "pinia": "^3.0.3",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.3.3",
    "three": "^0.184.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.45.0",
    "vite": "^7.0.4",
    "vitest": "^4.1.9",
    "vue": "^3.5.17",
    "vue-eslint-parser": "^10.2.0",
    "vue-router": "4",
    "vue-tsc": "^2.2.12",
    "vuedraggable": "^4.1.0",
    "wait-on": "^8.0.4"
  },
  "resolutions": {
    "@types/node": "22.17.1",
    "ajv@^6.10.0": "6.14.0",
    "ajv@^6.12.0": "6.14.0",
    "ajv@^6.12.4": "6.14.0",
    "flatted": "^3.4.2",
    "dompurify@3.1.7": "3.2.7",
    "lodash-es@^4.17.15": "4.17.23",
    "minimatch@^3.0.4": "3.1.3",
    "minimatch@^3.0.5": "3.1.3",
    "minimatch@^3.1.1": "3.1.3",
    "minimatch@^3.1.2": "3.1.3",
    "minimatch@^5.0.1": "5.1.7",
    "minimatch@^9.0.3": "9.0.6",
    "minimatch@^9.0.4": "9.0.6",
    "minimatch@^10.0.3": "10.2.1",
    "minimatch@^10.1.1": "10.2.1",
    "picomatch@^2.3.1": "2.3.2",
    "picomatch@^4.0.3": "4.0.4",
    "rollup": "4.59.0"
  },
  "packageManager": "yarn@4.9.1"
}
