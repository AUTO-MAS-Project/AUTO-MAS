<template>
  <section class="page-shell">
    <header class="panel">
      <div>
        <span class="eyebrow">Plugin Page</span>
        <h2>{{ title || '${plugin_title}' }}</h2>
        <p>{{ message }}</p>
      </div>
      <button type="button" :disabled="loading" @click="handleRequestBackend">
        {{ loading ? '同步中' : '刷新数据' }}
      </button>
    </header>

    <section class="panel">
      <div class="section-title">宿主上下文</div>
      <dl>
        <div v-for="item in contextRows" :key="item.label">
          <dt>{{ item.label }}</dt>
          <dd>{{ item.value }}</dd>
        </div>
      </dl>
    </section>

    <section class="panel">
      <div class="section-title">后端返回</div>
      <pre>{{ responseText }}</pre>
    </section>
  </section>
</template>

<script setup lang="ts">
import { computed, onMounted, ref } from 'vue'

interface BackendResponse {
  message?: string
  plugin?: string
  instance_id?: string
  page_path?: string
  element_tag?: string
  server_time?: string
}

defineProps<{
  title?: string
}>()

const loading = ref(false)
const response = ref<BackendResponse | null>(null)
const responseText = ref('等待首次同步...')
const pageContext = computed(() => window.pluginAPI?.getPageContext?.() || null)

const message = computed(() => {
  return response.value?.message || '这个页面由 ${plugin_name} 插件的 Vue 源码动态加载。'
})

const contextRows = computed(() => [
  { label: 'pageId', value: pageContext.value?.pageId || 'unknown' },
  { label: 'pluginId', value: pageContext.value?.pluginId || response.value?.plugin || 'unknown' },
  { label: 'elementTag', value: pageContext.value?.elementTag || response.value?.element_tag || 'unknown' },
  { label: 'instance', value: response.value?.instance_id || 'unknown' },
  { label: 'serverTime', value: response.value?.server_time || 'unknown' },
])

async function handleRequestBackend(): Promise<void> {
  loading.value = true
  responseText.value = '正在请求插件后端...'
  try {
    const result = (await window.pluginAPI.call('hello')) as BackendResponse
    response.value = result
    responseText.value = JSON.stringify(result, null, 2)
  } catch (error) {
    responseText.value = error instanceof Error ? error.message : String(error)
  } finally {
    loading.value = false
  }
}

onMounted(() => {
  void handleRequestBackend()
})
</script>

