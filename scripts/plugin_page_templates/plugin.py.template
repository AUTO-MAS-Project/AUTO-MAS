from __future__ import annotations

from datetime import datetime
from typing import Any

from auto_mas_core import ExtensionPlugin, plugin_route
from auto_mas_core.utils import get_logger

from .schema import Config


class Plugin(ExtensionPlugin):
    """${plugin_title} 带页面插件。"""

    config_class = Config

    @plugin_route("/hello", methods=["GET", "POST"])
    def _handle_hello(self) -> dict[str, Any]:
        # 启用后由 Manager 挂到 /api/plugin/<名>/hello
        cfg = self.config
        hello = "你好，这里是 ${plugin_title}。"
        if cfg is not None and hasattr(cfg, "hello"):
            hello = str(getattr(cfg, "hello") or hello)
        now = datetime.now().astimezone()
        return {
            "message": hello,
            "plugin": "${plugin_name}",
            "page_path": "${plugin_page_path}",
            "element_tag": "${plugin_element_tag}",
            "server_time": now.isoformat(timespec="seconds"),
        }

    async def on_enable(self) -> None:
        get_logger("${plugin_name}").info("enabled")

    async def on_disable(self) -> None:
        get_logger("${plugin_name}").info("disabled")
