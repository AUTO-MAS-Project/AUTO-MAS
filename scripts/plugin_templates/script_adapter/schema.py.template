from __future__ import annotations

from pydantic import BaseModel, ConfigDict, Field


class PluginConfig(BaseModel):
    """插件实例配置。"""

    model_config = ConfigDict(extra="allow")

    log_prefix: str = Field(
        default="${plugin_name}",
        description="用于区分当前插件输出的日志来源。",
    )
    strict_check: bool = Field(
        default=True,
        description="启用后会在运行前执行更严格的前置校验。",
    )


class Config(PluginConfig):
    """宿主插件系统读取的实例配置入口。"""


class ScriptSchema(BaseModel):
    """脚本配置。"""

    model_config = ConfigDict(extra="allow")

    script_name: str = Field(default="新专项脚本", description="脚本列表中展示的名称。")
    enabled: bool = Field(default=True, description="关闭后运行时可自行选择跳过。")
    launch_target: str = Field(default="", description="例如游戏路径、URI 或业务关键字。")
    working_directory: str = Field(default="", description="可选，用于指定专项运行目录。")
    notes: str = Field(default="", description="脚本备注。")


class UserSchema(BaseModel):
    """用户配置。"""

    model_config = ConfigDict(extra="allow")

    user_name: str = Field(default="新用户", description="用户列表中展示的名称。")
    enabled: bool = Field(default=True, description="关闭后默认跳过该用户。")
    account_id: str = Field(default="", description="按需填写业务侧账号标识。")
    profile: str = Field(default="default", description="示例字段，可映射不同档位或渠道。")
    notes: str = Field(default="", description="用户备注。")
