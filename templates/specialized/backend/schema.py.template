class XxxConfig(BaseModel):
    Info: Optional[XxxConfig_Info] = Field(default=None, description="脚本基础信息")
    Script: Optional[XxxConfig_Script] = Field(default=None, description="脚本配置")
    Game: Optional[XxxConfig_Game] = Field(default=None, description="游戏配置")
    Task: Optional[XxxConfig_Task] = Field(default=None, description="专项任务配置")
